[Unit]
Description=Jetson browser dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jetson-dashboard
Group=jetson-dashboard
EnvironmentFile=/etc/jetson-dashboard/dashboard.env
ExecStart=/opt/jetson-dashboard/jetson-dashboard
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
