# Generate a random 32-byte secret; store its SHA-256 hex digest here.
# deploy/install.py does this without printing credentials into logs.
DASHBOARD_LISTEN=192.168.68.107:8443
DASHBOARD_FILE_ROOT=/home/shai/dashboard-share
DASHBOARD_USERNAME=dashboard
DASHBOARD_SECRET_SHA256=REPLACE_WITH_64_HEX_DIGEST
DASHBOARD_TLS_CERT=/etc/jetson-dashboard/cert.pem
DASHBOARD_TLS_KEY=/etc/jetson-dashboard/key.pem
